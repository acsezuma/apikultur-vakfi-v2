# apikulturvakfi.org (cPanel / Apache)
# Klasörde eski bir index.php kalmışsa bile ana sayfa olarak index.html açılsın
DirectoryIndex index.html

# Türkçe karakterler doğru görünsün
AddDefaultCharset UTF-8

# SVG logolar ve favicon resim olarak sunulsun
AddType image/svg+xml .svg

# https yönlendirmesi cPanel'de (Domains → Force HTTPS Redirect) açık; burada tekrar açmaya gerek yok.
# cPanel ayarı kapatılırsa aşağıdaki üç satırın başındaki # işareti kaldırılabilir:
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
